CMovie::~CMovie()
{
    title = "";
    name = "";
    age = 0;
    price = 0.0;
}

CMovie::CMovie() {
    title = "";
    name = "";
    age = 0;
    price = 0.0;
}

CMovie::CMovie(string t, string n, int a, double p) {
    title = t;
    name = n;
    age = a;
    price = p;
}

void CMovie::displaydetails() {
    cout << "Title: " << title
         << " | Name: " << name
         << " | Age: " << age
         << " | Price: $" << price << endl;
}

void CMovie::get()
{
    cout << "Enter Title: ";
    cin >> title;
    cout << "Enter Name: ";
    cin >> name;
    cout << "Enter age: ";
    cin >> age;
    cout << "Enter Price: ";
    cin >> price;
}


CNode::CNode() {
    movie = NULL;
    next = NULL;
}

CNode::CNode(CMovie* m) {
    movie = m;
    next = NULL;
}

CNode::~CNode() {
    delete movie;
}

void CNode::display() {
    if (movie!= NULL) {
        movie->displaydetails();
    }
}


CLStack::CLStack() {
    top = NULL;
}

CLStack::~CLStack() {
    makelistempty();
}

int CLStack::push(CMovie* m) {
    CNode* node = new CNode(m);
    if (!node) {
        return -1;
    }
    node->next = top;
    top = node;
    return 0;
}

int CLStack::pop() {
    if (isempty()) {
        return -1;
    }
    CNode* temp = top;
    top = top->next;
    delete temp;
    return 0;
}

int CLStack::peek() {
    if (isempty()) {
        return -1;
    }
    top->display();
    return 0;
}

int CLStack::makelistempty() {
    while (!isempty()) {
        pop();
    }
    return 0;
}

void CLStack::display() {
    if (isempty()) {
        cout << "Stack is empty." << endl;
        return;
    }
    cout << "Stack contents (Top to Bottom):" << endl;
    CNode* current = top;
    while (current != NULL) {
        current->display();
        current = current->next;
    }
}

int CLStack::isempty() {
    return top == NULL;
}

int CLStack::size() {
    int count = 0;
    CNode* current = top;
    while (current != NULL) {
        count++;
        current = current->next;
    }
    return count;
}

