    else
    {
        cout<<"===============================================================================================\n";
        cout<<"Title\t\t\tName\t\t\tage\t\t\tPrice\n";
        cout<<"===============================================================================================\n";
        stackarray[top].displaydetails();
        cout<<"===============================================================================================\n";
        return 1;
    }
}
int CAStack::size()
{
    if(isempty())
    {
        return -1;
    }
    else
    {
        return top+1;
    }
}
void CAStack::display()
{
    if(isempty())
    {
        cout << "list is empty" << endl;
    }
    else
    {
       cout << "================================================================================================\n";
       cout << "Title\t\t\tName\t\t\tage\t\t\tPrice\n";
       cout << "================================================================================================\n";
       for(int i = 0; i <= top; i++)
       {
           stackarray[i].displaydetails();
       }
       cout << "================================================================================================\n";

    }
}
int CAStack::push(CMovie ele)
{
    if(isfull())
    {
        return -1;
    }
    else
    {
        top++;
        stackarray[top] = ele;
        return 1;
    }
}
int CAStack::pop()
{
    if(isempty())
    {
        return -1;
    }
    else
    {
        top--;
        return 1;
    }
}
int CAStack::makestackempty()
{
    if(isempty())
    {
        return -1;
    }
    else
    {
        top = -1;
        return 1;
    }
}
