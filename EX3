CAStack::CAStack(int cap)
{
    capacity = cap;
    stackarray = new CMovie[capacity];
    top = -1;
}

int CAStack :: isfull()
{
    if (top == capacity - 1)
    {
        return 1;
    }
    else
    {
        return 0;
    }
}
int CAStack::isempty()
{
    if (top == -1)
    {
        return 1;
    }
    else
    {
        return 0;
    }
}
int CAStack::peek()
{
