{
    CBST b;
    bool ret;
    int n;
    do
    {
        cout<<"1.Isempty\n2. Insert Movie\n3. InOrder\n4.Findmin\n5.Findmax\n6.Search\n7.Preorder\n8.Postorder\n9.Delete\n10.Getroot\n11.MakeEmpty\n0.Exit \n";
