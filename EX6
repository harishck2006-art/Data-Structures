#include <iostream>
using namespace std;

class CNode;
class CBST;

class Movie
{
    friend class CBST;
private:
    string title;
    string name;
    int age;
    int price;
public:
    Movie();
    Movie(string, string, int, int);
    Movie(const Movie &);
    ~Movie();
    void GetMovie();
    void DisplayMovie();
    int Getage();
};

class CNode
{
    friend class CBST;
private:
    Movie data;
    CNode *left;
    CNode *right;
public:
    CNode();
    CNode(Movie);
    ~CNode();
    void Getdata();
    void Displaydata();
};

class CBST
{
private:
    CNode *root;
    void FreeTree(CNode* node);  
public:
    CBST();
    ~CBST();
    CNode* Getroot();
    void Setroot(CNode *r);
    bool Isempty();
    bool Insert(CNode *,CNode *);
    void Inorder(CNode*);
    CNode* Findmin(CNode*);
    CNode* Findmax(CNode*);
    CNode* Search(CNode*,int);
    void Preorder(CNode*);
    void Postorder(CNode*);
    CNode* Deleteelt(CNode*,int,bool&);

   
    void MakeEmpty();
};

