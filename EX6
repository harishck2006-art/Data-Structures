//|------CNODE IMPLEMENTATION------|
CNode::CNode()
{
    right = left = NULL;
}
CNode::CNode(Movie d)
{
    data = d;
    right = left = NULL;
}
CNode::~CNode()
{
    right = left = NULL;
}
void CNode::Getdata()
{
    data.GetMovie();
}
void CNode::Displaydata()
{
    data.DisplayMovie();
}

//"|------BST IMPLEMENTATION------|
CBST::CBST()
{
   root = NULL;
}
void CBST::FreeTree(CNode* node)
{
    if(node)
    {
        FreeTree(node->left);
        FreeTree(node->right);
        delete node;
    }
}
CBST::~CBST()
{
   FreeTree(root);
   root = NULL;
}
CNode* CBST::Getroot()
{
   return root;
}
void CBST::Setroot(CNode* r)
{
   root = r;
}
bool CBST::Isempty()
{
    return (root == NULL);
}
bool CBST::Insert(CNode *temp, CNode *newNode)
{
    if(Isempty())
    {
        root = newNode;
        return true;
    }
    else
    {
        if(temp->data.age > newNode->data.age)
        {
            if(temp->left == NULL)
            {
                temp->left = newNode;
                return true;
            }
            else
                return Insert(temp->left, newNode);
        }
        else if(temp->data.age < newNode->data.age)
        {
            if(temp->right == NULL)
            {
                temp->right = newNode;
                return true;
            }
            else
                return Insert(temp->right, newNode);
        }
        else
            return false;
    }
}
void CBST::Inorder(CNode *temp)
{
    if(temp != NULL)
    {
        Inorder(temp->left);
        temp->data.DisplayMovie();
        Inorder(temp->right);
    }
}
CNode* CBST::Findmin(CNode* root)
{
    CNode* temp = root;
    while(temp->left != NULL)
    {
        temp = temp->left;
    }
    return temp;
}
CNode* CBST::Findmax(CNode* root)
{
    CNode* temp = root;
    while(temp->right != NULL)
    {
        temp = temp->right;
    }
    return temp;
}
CNode* CBST::Search(CNode* temp, int elt)
{
    if(temp == NULL || temp->data.age == elt)
    {
        return temp;
    }
    else if(temp->data.age < elt)
    {
        return Search(temp->right, elt);
    }
    else if(temp->data.age > elt)
    {
        return Search(temp->left, elt);
    }
    else
    {
        return NULL;
    }
}
void CBST::Preorder(CNode* temp)
{
    if(temp != NULL)
    {
        temp->data.DisplayMovie();
        Preorder(temp->left);
        Preorder(temp->right);
    }
}
void CBST::Postorder(CNode* temp)
{
    if(temp != NULL)
    {
        Postorder(temp->left);
        Postorder(temp->right);
        temp->data.DisplayMovie();
    }
}
CNode* CBST::Deleteelt(CNode* temp, int elt, bool &status)
{
    if (temp == NULL)
    {
        status = false;
        return NULL;
    }
    else if (elt < temp->data.age)
    {
        temp->left  = Deleteelt(temp->left,  elt, status);
    }
    else if (elt > temp->data.age)
    {
        temp->right = Deleteelt(temp->right, elt, status);
    }
    else
    { // found it
        if (temp->left == NULL && temp->right == NULL)
        {
            delete temp;
            temp = NULL;
            status = true;
        }
        else if (temp->left == NULL)
        {
            CNode* child = temp->right;
            delete temp;
            temp = child;
            status = true;
        }
        else if (temp->right == NULL)
        {
            CNode* child = temp->left;
            delete temp;
            temp = child;
            status = true;
        }
        else
        {
            CNode* min = Findmin(temp->right);
            temp->data = min->data;
            temp->right = Deleteelt(temp->right, min->data.age, status);
        }
    }
    return temp;
}


void CBST::MakeEmpty()
{
    FreeTree(root);
    root = NULL;
    cout << "The BST is  completely empty!\n";
}

