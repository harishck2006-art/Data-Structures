// ===================== CLList =====================
CLList::CLList()
{
    first = NULL;
}

int CLList::isEmpty()
{
    return first == NULL ? 1 : 0;
}

int CLList::displayLength()
{
    if (isEmpty())
        return -1;
    int count = 0;
    CNode *temp = first;
    while (temp != NULL)
    {
        count++;
        temp = temp->next;
    }
    return count;
}

int CLList::displayList()
{
    if (isEmpty())
        return -1;
    int count = 0;
    cout << "Movie\t|\tCustomer\t|\tAge\t|\tSeatNo\n";
    cout << "-----------------------------------------------------------------\n";
    CNode *temp = first;
    while (temp != NULL)
    {
        count++;
        temp->display(count);
        temp = temp->next;
    }
    return 1;
}

int CLList::insertAtFirst(CNode *newNode)
{
    if (isEmpty())
    {
        first = newNode;
        return 1;
    }
    newNode->next = first;
    first = newNode;
    return 2;
}

int CLList::insertByPosition(int pos, CNode *n)
{
    if (isEmpty())
    {
        if (pos == 1)
        {
            insertAtFirst(n);
            return 1;
        }
        else
            return -2; // invalid position
    }
    else if (pos == 1)
    {
        insertAtFirst(n);
        return 2;
    }
    int count = 1;
    CNode *temp = first, *prev;
    while (temp != NULL && count < (pos - 1))
    {
        temp = temp->next;
        count++;
    }
    if (count == (pos - 1) && temp != NULL)
    {
        prev = temp;
        temp = temp->next;
        prev->next = n;
        n->next = temp;
        return 3;
    }
    return -2;
}

int CLList::insertAtLast(CNode *n)
{
    if (isEmpty())
    {
        first = n;
        return 1;
    }
    CNode *temp = first;
    while (temp->next != NULL)
    {
        temp = temp->next;
    }
    temp->next = n;
    return 2;
}

// ===== NEW: Insert Before Seat =====
int CLList::insertBeforeSeat(int seat, CNode *n)
{
    if (isEmpty())
        return -1;
    if (first->data.seatNo == seat)
        return insertAtFirst(n);

    CNode *temp = first, *prev = NULL;
    while (temp != NULL && temp->data.seatNo != seat)
    {
        prev = temp;
        temp = temp->next;
    }
    if (temp == NULL)
        return -2; // seat not found

    prev->next = n;
    n->next = temp;
    return 1;
}

// ===== NEW: Insert After Seat =====
int CLList::insertAfterSeat(int seat, CNode *n)
{
    if (isEmpty())
        return -1;

    CNode *temp = first;
    while (temp != NULL && temp->data.seatNo != seat)
    {
        temp = temp->next;
    }
    if (temp == NULL)
        return -2;

    n->next = temp->next;
    temp->next = n;
    return 1;
}

int CLList::deleteAtFirst()
{
    if (isEmpty())
        return -1;
    CNode *temp = first;
    first = first->next;
    delete temp;
    return 2;
}

int CLList::deleteAtLast()
{
    if (isEmpty())
        return -1;
    CNode *temp = first, *prev = NULL;
    while (temp->next != NULL)
    {
        prev = temp;
        temp = temp->next;
    }
    if (prev)
        prev->next = NULL;
    else
        first = NULL;
    delete temp;
    return 1;
}

int CLList::deleteByPosition(int pos)
{
    if (isEmpty())
        return -1;
    if (pos == 1)
        return deleteAtFirst();

    CNode *prev = NULL, *temp = first;
    int count = 1;
    while (temp != NULL && count < (pos - 1))
    {
        temp = temp->next;
        count++;
    }
    if (count == (pos - 1) && temp != NULL && temp->next != NULL)
    {
        prev = temp;
        temp = temp->next;
        prev->next = temp->next;
        delete temp;
        return 1;
    }
    return -2;
}

// ===== NEW: Delete Before Seat =====
int CLList::deleteBeforeSeat(int seat)
{
    if (isEmpty() || first->data.seatNo == seat)
        return -1; // nothing before

    CNode *prev = NULL, *curr = first, *beforePrev = NULL;
    while (curr != NULL && curr->data.seatNo != seat)
    {
        beforePrev = prev;
        prev = curr;
        curr = curr->next;
    }
    if (curr == NULL || prev == NULL)
        return -2; // seat not found or no node before it

    if (beforePrev == NULL)
        first = curr;
    else
        beforePrev->next = curr;

    delete prev;
    return 1;
}

// ===== NEW: Delete After Seat =====
int CLList::deleteAfterSeat(int seat)
{
    if (isEmpty())
        return -1;

    CNode *temp = first;
    while (temp != NULL && temp->data.seatNo != seat)
    {
        temp = temp->next;
    }
    if (temp == NULL || temp->next == NULL)
        return -2; // seat not found or no after node

    CNode *delNode = temp->next;
    temp->next = delNode->next;
    delete delNode;
    return 1;
}

int CLList::makeListEmpty()
{
    while (!isEmpty())
    {
        deleteAtFirst();
    }
    return 1;
}

int CLList::searchBySeatNo(int seat)
{
    if (isEmpty())
        return -1;
    int pos = 1;
    CNode *temp = first;
    while (temp != NULL)
    {
        if (temp->data.seatNo == seat)
            return pos;
        temp = temp->next;
        pos++;
    }
    return -2;
}

int CLList::deleteBySeatNo(int seat)
{
    if (isEmpty())
        return -1;
    if (first->data.seatNo == seat)
        return deleteAtFirst();

    CNode *temp = first, *prev = NULL;
    while (temp != NULL && temp->data.seatNo != seat)
    {
        prev = temp;
        temp = temp->next;
    }
    if (temp == NULL)
        return -2; // seat not found

    prev->next = temp->next;
    delete temp;
    return 1;
}

int CLList::replaceSeatDetails(int pos)
{
    if (isEmpty())
        return -1;
    int count = 1;
    CNode *temp = first;
    while (temp != NULL && count < pos)
    {
        temp = temp->next;
        count++;
    }
    if (temp == NULL)
        return -2;

    cout << "Enter new details for position " << pos << endl;
    temp->get();
    return 1;
}

int CLList::getSeatDetails(int pos)
{
    if (isEmpty())
        return -1;
    int count = 1;
    CNode *temp = first;
    while (temp != NULL && count < pos)
    {
        temp = temp->next;
        count++;
    }
    if (temp == NULL)
    {
        cout << "Invalid position or not found\n";
        return -2;
    }
    cout << "Movie\t|\tCustomer\t|\tAge\t|\tSeatNo\n";
    cout << "----------------------------------------------------\n";
    temp->display(pos);
    return 1;
}

int CLList::sort()
{
    if (isEmpty() || first->next == NULL)
        return -1;
    for (CNode *i = first; i->next != NULL; i = i->next)
    {
        for (CNode *j = i->next; j != NULL; j = j->next)
        {
            if (i->data.seatNo > j->data.seatNo)
            {
                swap(i->data, j->data);
            }
        }
    }
    return 1;
}

void CLList::displayReverseHelper(CNode *node, int &count)
{
    if (node == NULL)
        return;
    displayReverseHelper(node->next, count);
    count++;
    node->display(count);
}

int CLList::displayReverse()
{
    if (isEmpty())
        return -1;
    int count = 0;
    cout << "Movie\t|\tCustomer\t|\tAge\t|\tSeatNo\n";
    cout << "----------------------------------------------------\n";
    displayReverseHelper(first, count);
    return 1;
}

