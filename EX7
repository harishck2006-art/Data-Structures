                cout << "Customer Age: ";
                cin >> age;
                cout << "Ticket Price: ";
                cin >> price;

                arr[i] = CMovieTicket(name, title, age, price);
            }

            if (queue.buildHeap(arr, n) == 1)
                cout << "Ticket heap built successfully.\n";
            else
                cout << "Heap build failed.\n";

            delete[] arr;
            break;
