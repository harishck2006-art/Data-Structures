int main() {
    CMoviePriorityQueue queue;
    int choice;

    cout << "\n====== Movie Ticket Booking System ======\n";
    cout << "1. Book Movie Ticket\n";
    cout << "2. Delete Ticket with Lowest Age\n";
    cout << "3. Display All Tickets\n";
    cout << "4. Show Ticket with Lowest Age\n";
    cout << "5. Increase Age by Amount\n";
    cout << "6. Increase Age to New Value\n";
    cout << "7. Decrease Age by Amount\n";
    cout << "8. Decrease Age to New Value\n";
    cout << "9. Build Ticket Heap\n";
    cout << "10. Check if Queue is Full or Empty\n";
    cout << "11. Exit\n";

    do {
        cout << "===================================================\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
        case 1: {
            string name, title;
            int age;
            float price;

