#include "header.h"

// --- CMovieTicket Implementation ---

CMovieTicket::CMovieTicket() : name(""), title(""), age(0), price(0.0), priority(-1) {}

CMovieTicket::CMovieTicket(string n, string t, int a, float p)
    : name(n), title(t), age(a), price(p), priority(a) {}

CMovieTicket::CMovieTicket(const CMovieTicket &other) {
    name = other.name;
    title = other.title;
    age = other.age;
    price = other.price;
    priority = other.priority;
}

void CMovieTicket::display() const {
    cout << name << "\t\t" << title << "\t\t" << age << "\t\t" << price << endl;
}

int CMovieTicket::getPriority() const {
    return priority;
}

void CMovieTicket::setPriority(int p) {
    priority = p;
    age = p;
}

// --- CMoviePriorityQueue Implementation ---

CMoviePriorityQueue::CMoviePriorityQueue() {
    capacity = 31;
    heapSize = 0;
    heap = new CMovieTicket[capacity + 1];
}

CMoviePriorityQueue::CMoviePriorityQueue(int height) {
    capacity = pow(2, (height + 1)) - 1;
    heapSize = 0;
    heap = new CMovieTicket[capacity + 1];
}

CMoviePriorityQueue::~CMoviePriorityQueue() {
    delete[] heap;
}

int CMoviePriorityQueue::insert(CMovieTicket item) {
    if (isFull()) {
        cout << "Error: Queue is full." << endl;
        return -1;
    }
    heapSize++;
    int index = percolateUp(heapSize, item);
    heap[index] = item;
    return 1;
}

int CMoviePriorityQueue::deleteMin() {
    if (isEmpty()) return -1;

    heap[1] = heap[heapSize--];
    if (!isEmpty()) percolateDown(1);

    return 1;
}

CMovieTicket CMoviePriorityQueue::returnMin() {
    if (isEmpty()) return CMovieTicket();
    return heap[1];
}

void CMoviePriorityQueue::displayTickets() {
    if (isEmpty()) {
        cout << "No Tickets Booked.\n";
        return;
    }
    for (int i = 1; i <= heapSize; i++) {
        heap[i].display();
    }
}

int CMoviePriorityQueue::percolateUp(int index, CMovieTicket item) {
    while (index > 1 && heap[index / 2].getPriority() > item.getPriority()) {
        heap[index] = heap[index / 2];
        index /= 2;
    }
    return index;
}

void CMoviePriorityQueue::percolateDown(int index) {
    int child;
    CMovieTicket tmp = heap[index];
    for (; index * 2 <= heapSize; index = child) {
        child = index * 2;
        if (child != heapSize && heap[child + 1].getPriority() < heap[child].getPriority()) {
            child++;
        }
        if (heap[child].getPriority() < tmp.getPriority())
            heap[index] = heap[child];
        else
            break;
    }
    heap[index] = tmp;
}

int CMoviePriorityQueue::findIndexByPriority(int oldPriority) {
    for (int i = 1; i <= heapSize; i++) {
        if (heap[i].getPriority() == oldPriority)
            return i;
    }
    return -1;
}

int CMoviePriorityQueue::increaseKeyBy(int oldPriority, int amount) {
    int index = findIndexByPriority(oldPriority);
    if (index < 1 || index > heapSize || amount <= 0) return -1;
    int newPriority = heap[index].getPriority() + amount;
    return increaseKeyWith(oldPriority, newPriority);
}

int CMoviePriorityQueue::increaseKeyWith(int oldPriority, int newPriority) {
    int index = findIndexByPriority(oldPriority);
    if (index < 1 || index > heapSize || newPriority < heap[index].getPriority()) return -1;
    heap[index].setPriority(newPriority);
    percolateDown(index);
    return 1;
}

int CMoviePriorityQueue::decreaseKeyBy(int oldPriority, int amount) {
    int index = findIndexByPriority(oldPriority);
    if (index < 1 || index > heapSize || amount <= 0) return -1;
    int newPriority = heap[index].getPriority() - amount;
    return decreaseKeyWith(oldPriority, newPriority);
}

int CMoviePriorityQueue::decreaseKeyWith(int oldPriority, int newPriority) {
    int index = findIndexByPriority(oldPriority);
    if (index < 1 || index > heapSize || newPriority > heap[index].getPriority()) return -1;
    CMovieTicket item = heap[index];
    item.setPriority(newPriority);
    int newIndex = percolateUp(index, item);
    heap[newIndex] = item;
    return 1;
}

int CMoviePriorityQueue::buildHeap(CMovieTicket* items, int size) {
    if (size > capacity) return -1;
    for (int i = 0; i < size; i++) {
        heap[i + 1] = items[i];
    }
    heapSize = size;
    for (int i = heapSize / 2; i > 0; i--) percolateDown(i);
    return 1;
}

int CMoviePriorityQueue::isFull() const {
    return heapSize == capacity;
}

int CMoviePriorityQueue::isEmpty() const {
    return heapSize == 0;
}

