        case 10: {
            if (queue.isEmpty())
                cout << "Queue is empty.\n";
            else
                cout << "Queue is not empty.\n";

            if (queue.isFull())
                cout << "Queue is full.\n";
            else
                cout << "Queue is not full.\n";
            break;
        }

        case 11:
            cout << "Exiting program...\n";
            break;

        default:
            cout << "Invalid choice! Try again.\n";
        }

    } while (choice != 11);

    return 0;
}

