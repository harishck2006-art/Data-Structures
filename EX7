            cin >> name;
            cout << "Enter Movie Title: ";
            cin >> title;
            cout << "Enter Customer Age: ";
            cin >> age;
            cout << "Enter Ticket Price: ";
            cin >> price;

            CMovieTicket t(name, title, age, price);
