                cout << "Ticket booked successfully.\n";
            else
                cout << "Queue is full.\n";
            break;
        }

        case 2: {
            cout << "\nDeleting ticket with lowest age (highest priority):\n";
            cout << "Name\t\tTitle\t\tAge\t\tPrice\n";
            cout << "--------------------------------------------------------------\n";
            queue.returnMin().display();
            cout << "--------------------------------------------------------------\n";
            if (queue.deleteMin() != -1)
                cout << "Ticket deleted successfully.\n";
            else
                cout << "Queue is empty.\n";
            break;
        }

        case 3: {
            cout << "\n--- All Booked Tickets ---\n";
            cout << "Name\t\tTitle\t\tAge\t\tPrice\n";
            cout << "--------------------------------------------------------------\n";
            queue.displayTickets();
            cout << "--------------------------------------------------------------\n";
            break;
        }

        case 4: {
            if (queue.isEmpty())
                cout << "Queue is empty.\n";
            else {
                cout << "\n--- Ticket with Lowest Age ---\n";
                cout << "Name\t\tTitle\t\tAge\t\tPrice\n";
                cout << "--------------------------------------------------------------\n";
                queue.returnMin().display();
                cout << "--------------------------------------------------------------\n";
            }
            break;
        }

        case 5: {
            int oldAge, amount;
            cout << "Enter Old Age to be changed: ";
            cin >> oldAge;
            cout << "Enter Age to increase by: ";
            cin >> amount;
            if (queue.increaseKeyBy(oldAge, amount) == 1)
                cout << "Age increased successfully.\n";
            else
                cout << "Invalid input.\n";
            break;
        }

        case 6: {
            int oldAge, newAge;
            cout << "Enter Old Age: ";
            cin >> oldAge;
            cout << "Enter New Age: ";
            cin >> newAge;
            if (queue.increaseKeyWith(oldAge, newAge) == 1)
                cout << "Age updated successfully.\n";
            else
                cout << "Invalid operation.\n";
            break;
        }

        case 7: {
            int oldAge, amount;
            cout << "Enter Old Age: ";
            cin >> oldAge;
            cout << "Enter Age to decrease by: ";
            cin >> amount;
            if (queue.decreaseKeyBy(oldAge, amount) == 1)
                cout << "Age decreased successfully.\n";
            else
                cout << "Invalid input.\n";
            break;
        }

        case 8: {
            int oldAge, newAge;
            cout << "Enter Old Age: ";
            cin >> oldAge;
            cout << "Enter New Age: ";
            cin >> newAge;
            if (queue.decreaseKeyWith(oldAge, newAge) == 1)
                cout << "Age updated successfully.\n";
            else
                cout << "Invalid operation.\n";
            break;
        }

        case 9: {
            int n;
            cout << "Enter number of tickets: ";
            cin >> n;

            CMovieTicket *arr = new CMovieTicket[n];
            for (int i = 0; i < n; i++) {
                string name, title;
                int age;
                float price;
                cout << "\nTicket " << i + 1 << ":\n";
                cout << "Customer Name: ";
                cin >> name;
                cout << "Movie Title: ";
