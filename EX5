#include "header.h"

int main()
{
    CAVL tree;
    int choice;

    do
    {
        cout << "\n====== Movie AVL Tree Menu ======\n";
        cout << "1. Insert Movie\n";
        cout << "2. Delete Movie by Age\n";
        cout << "3. Search Movie by Age\n";
        cout << "4. Display InOrder\n";
        cout << "5. Display PreOrder\n";
        cout << "6. Display PostOrder\n";
        cout << "7. Find Movie with Minimum Age\n";
        cout << "8. Find Movie with Maximum Age\n";
        cout << "9. Exit\n";
        cout << "Enter your choice: ";
        if (!(cin >> choice))
        {
            cout << "Invalid input. Exiting.\n";
            return 0;
        }

        switch(choice)
        {
            case 1:
            {
                string title, name;
                int age;
                double price;
                cout << "Enter Movie Title: ";
                cin >> title;
                cout << "Enter Customer Name: ";
                cin >> name;
                cout << "Enter Age: ";
                cin >> age;
                cout << "Enter Ticket Price: ";
                cin >> price;

                CMovie movie(title, name, age, price);
                CNode* newNode = new CNode(movie);
                tree.setRoot(tree.insertNode(tree.getRoot(), newNode)); // fixed line
                cout << "Movie Inserted Successfully.\n";
                break;
            }

            case 2:
            {
                int age;
                cout << "Enter Age to delete: ";
                cin >> age;
                cout << "Title\t\tName\t\tAge\t\tPrice\n";
                tree.setRoot(tree.deleteNode(tree.getRoot(), age)); // fixed line
                cout << "Deleted Successfully.\n";
                break;
            }

            case 3:
            {
                int age;
                cout << "Enter Age to search: ";
                cin >> age;
                cout << "Title\t\tName\t\tAge\t\tPrice\n";
                int result = tree.search(age);
                if(result == 1)
                    cout << "Movie found.\n";
                else
                    cout << "Movie with Age " << age << " not found!\n";
                break;
            }

            case 4:
            {
                cout << "InOrder Traversal:\n";
                cout << "Title\t\tName\t\tAge\t\tPrice\n";
                tree.inOrder(tree.getRoot());
                break;
            }

            case 5:
            {
                cout << "PreOrder Traversal:\n";
                cout << "Title\t\tName\t\tAge\t\tPrice\n";
                tree.preOrder(tree.getRoot());
                break;
            }

            case 6:
            {
                cout << "PostOrder Traversal:\n";
                cout << "Title\t\tName\t\tAge\t\tPrice\n";
                tree.postOrder(tree.getRoot());
                break;
            }

            case 7:
            {
                CNode* result = tree.findMin(tree.getRoot());
                if(result == NULL)
                    cout << "Tree is Empty\n";
                else
                {
                    cout << "Movie with Minimum Age:\n";
                    cout << "Title\t\tName\t\tAge\t\tPrice\n";
                    result->displayNode();
                }
                break;
            }

            case 8:
            {
                CNode* result = tree.findMax(tree.getRoot());
                if(result == NULL)
                    cout << "Tree is Empty\n";
                else
                {
                    cout << "Movie with Maximum Age:\n";
                    cout << "Title\t\tName\t\tAge\t\tPrice\n";
                    result->displayNode();
                }
                break;
            }

            case 9:
                cout << "Exiting...\n";
                return 0;

            default:
                cout << "Invalid choice! Try again.\n";
        }

    } while(choice != 9);

    return 0;
}

