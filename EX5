// ===== CAVL =====
CAVL::CAVL() : root(NULL) {}

CAVL::~CAVL()
{
    root = NULL;
}

int CAVL::isEmpty()
{
    return root == NULL;
}

int CAVL::getHeight(CNode* node)
{
    if (node == NULL) return 0;
    return node->height;
}

int CAVL::getBF(CNode* node)
{
    if (node == NULL) return 0;
    return getHeight(node->left) - getHeight(node->right);
}

// ===== Rotations =====
CNode* CAVL::LLRotate(CNode* k3)
{
    cout << "[Rotation: LL]\n";
    CNode* k2 = k3->left;
    CNode* temp = k2->right;

    k2->right = k3;
    k3->left = temp;

    k3->height = max(getHeight(k3->left), getHeight(k3->right)) + 1;
    k2->height = max(getHeight(k2->left), getHeight(k2->right)) + 1;

    return k2;
}

CNode* CAVL::RRRotate(CNode* k3)
{
    cout << "[Rotation: RR]\n";
    CNode* k2 = k3->right;
    CNode* temp = k2->left;

    k2->left = k3;
    k3->right = temp;

    k3->height = max(getHeight(k3->left), getHeight(k3->right)) + 1;
    k2->height = max(getHeight(k2->left), getHeight(k2->right)) + 1;

    return k2;
}

CNode* CAVL::LRRotate(CNode* k3)
{
    cout << "[Rotation: LR]\n";
    k3->left = RRRotate(k3->left);
    return LLRotate(k3);
}

CNode* CAVL::RLRotate(CNode* k3)
{
    cout << "[Rotation: RL]\n";
    k3->right = LLRotate(k3->right);
    return RRRotate(k3);
}

// ===== Insert Node =====
CNode* CAVL::insertNode(CNode* node, CNode* newNode)
{
    if (node == NULL)
        return newNode;

    if (newNode->data.age < node->data.age)
        node->left = insertNode(node->left, newNode);
    else if (newNode->data.age > node->data.age)
        node->right = insertNode(node->right, newNode);
    else
        return node; // duplicate age not allowed

    node->height = 1 + max(getHeight(node->left), getHeight(node->right));
    int balance = getBF(node);

    // LL
    if (balance > 1 && newNode->data.age < node->left->data.age)
        return LLRotate(node);

    // RR
    if (balance < -1 && newNode->data.age > node->right->data.age)
        return RRRotate(node);

    // LR
    if (balance > 1 && newNode->data.age > node->left->data.age)
        return LRRotate(node);

    // RL
    if (balance < -1 && newNode->data.age < node->right->data.age)
        return RLRotate(node);

    return node;
}

// ===== Search =====
int CAVL::search(int age)
{
    CNode* temp = root;
    while (temp != NULL)
    {
        if (age == temp->data.age)
        {
            temp->displayNode();
            return 1;
        }
        else if (age < temp->data.age)
            temp = temp->left;
        else
            temp = temp->right;
    }
    return -1;
}

// ===== Find Max/Min =====
CNode* CAVL::findMax(CNode* temp)
{
    if (temp == NULL) return NULL;
    while (temp->right != NULL) temp = temp->right;
    return temp;
}

CNode* CAVL::findMin(CNode* temp)
{
    if (temp == NULL) return NULL;
    while (temp->left != NULL) temp = temp->left;
    return temp;
}

// ===== Delete Node =====
CNode* CAVL::deleteNode(CNode* root, int age)
{
    if (root == NULL)
        return root;

    if (age < root->data.age)
        root->left = deleteNode(root->left, age);
    else if (age > root->data.age)
        root->right = deleteNode(root->right, age);
    else
    {
        if (root->left == NULL || root->right == NULL)
        {
            CNode* temp = root->left ? root->left : root->right;
            cout << "Deleted: ";
            root->displayNode();
            delete root;
            return temp;
        }

        CNode* temp = findMin(root->right);
        root->data = temp->data;
        root->right = deleteNode(root->right, temp->data.age);
    }

    if (root == NULL)
        return root;

    root->height = 1 + max(getHeight(root->left), getHeight(root->right));
    int balance = getBF(root);

    if (balance > 1 && getBF(root->left) >= 0)
        return LLRotate(root);

    if (balance > 1 && getBF(root->left) < 0)
        return LRRotate(root);

    if (balance < -1 && getBF(root->right) <= 0)
        return RRRotate(root);

    if (balance < -1 && getBF(root->right) > 0)
        return RLRotate(root);

    return root;
}

// ===== Traversals =====
void CAVL::inOrder(CNode* temp)
{
    if (temp != NULL)
    {
        inOrder(temp->left);
        temp->data.display();
        inOrder(temp->right);
    }
}

void CAVL::preOrder(CNode* temp)
{
    if (temp != NULL)
    {
        temp->data.display();
        preOrder(temp->left);
        preOrder(temp->right);
    }
}

void CAVL::postOrder(CNode* temp)
{
    if (temp != NULL)
    {
        postOrder(temp->left);
        postOrder(temp->right);
        temp->data.display();
    }
}

CNode* CAVL::getRoot()
{
    return root;
}

void CAVL::setRoot(CNode* r)
{
    root = r;
}

