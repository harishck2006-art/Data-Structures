#ifndef HEADER_H
#define HEADER_H

#include <iostream>
#include <algorithm>
using namespace std;

class CNode;
class CAVL;

// ===== Movie Class =====
class CMovie
{
    friend class CNode;
    friend class CAVL;

private:
    string title;   // Movie title
    string name;    // Customer name
    int age;        // Customer age (used as AVL key)
    double price;   // Ticket price

public:
    CMovie();
    CMovie(string t, string n, int a, double p);
    CMovie(const CMovie &other);
    ~CMovie();

    void display();
};

// ===== Node Class =====
class CNode
{
    friend class CAVL;
    friend class CMovie;

private:
    CMovie data;
    CNode* left;
    CNode* right;
    int height;

public:
    CNode();
    CNode(const CMovie &m);
    ~CNode();

    void displayNode();
};

// ===== AVL Class =====
class CAVL
{
private:
    CNode* root;

    int getHeight(CNode* node);
    int getBF(CNode* node);

    // Rotations
    CNode* LLRotate(CNode* k3);
    CNode* RRRotate(CNode* k3);
    CNode* LRRotate(CNode* k3);
    CNode* RLRotate(CNode* k3);

public:
    CAVL();
    ~CAVL();

    int isEmpty();
    CNode* insertNode(CNode* node, CNode* newNode);
    int search(int age);
    CNode* findMax(CNode* temp);
    CNode* findMin(CNode* temp);
    CNode* deleteNode(CNode* root, int age);

    void inOrder(CNode* temp);
    void preOrder(CNode* temp);
    void postOrder(CNode* temp);

    CNode* getRoot();
    void setRoot(CNode* r); // Added to fix segmentation fault
};

#endif

