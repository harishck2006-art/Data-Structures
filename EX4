CAQueue::CAQueue(int capacity)
{
    cap = capacity;
    queuearray = new CMovie[capacity];
    rear=front = -1;
}

int CAQueue::isfull()
{
    if((rear+1)%cap==front)
    {
        return 1;
    }
    else
    {
        return 0;
    }
}

int CAQueue::isempty()
{
    if(rear==-1&&front==-1)
       return 1;
    else
       return 0;
}

int CAQueue::peekrear()
{
    if(isempty())
        return -1;
    else {
        queuearray[rear].displaydetails();
        return 1;
    }
}

int CAQueue::peekfront()
{
   if (isempty())
      return -1;
   else
   {
      queuearray[front].displaydetails();
      return 1;
   }
}

int CAQueue::size()
{
    if(isempty())
        return -1;
    else{
        int count=0;
        for(int i=front;i<rear+1;i=(i%cap)+1)
           count++;
        return count;
    }
}

void CAQueue::display()
{
    if(isempty())
        cout << "queue is empty" << endl;
    else {
        int i=front;
        while(true)
        {
           queuearray[i].displaydetails();
           if(i==rear)
              break;
           else
              i=(i+1)%cap;
        }
    }
}

int CAQueue::enqueue(CMovie ele)
{
    if(isfull())
        return -1;
    else if(isempty())
    {
       front=rear=0;
       queuearray[rear]=ele;
       return 1;
    }
    else
    {
       rear=(rear+1)%cap;
       queuearray[rear]=ele;
       return 2;
    }
}

int CAQueue::dequeue()
{
    if(isempty())
        return -1;
    else if(front==rear)

    {
       queuearray[front].displaydetails();
       queuearray[front]=CMovie();
       front=rear=-1;
       return 1;
    }
    else {
        queuearray[front].displaydetails();
        front=(front+1)%cap;
        return 2;
    }
}

int CAQueue::makelistempty()
{
    if(isempty())
        return -1;
    else {
        while(!isempty()){
           dequeue();
        }
        return 1;
    }
}
