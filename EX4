void CAQueue::Displayqueue() {
    if (Isempty()) {
        cout << "Queue is Empty!" << endl;
        return;
    }

    cout << "\n:::::: MOVIE DETAILS ::::::\n";
    cout << "Title\tNAME\tAge\tPrice\n";

    Node* temp = front;
    while (temp != NULL) {
        temp->data.DisplayMovie();
        temp = temp->next;
    }
}

bool CAQueue::Enqueue(Movie m) {
    Node* newNode = new Node;
    if (!newNode) {
        cout << "Memory Allocation Failed!" << endl;
        return false;
    }

    newNode->data = m;
    newNode->next = NULL;

    if (Isempty()) {
        front = rear = newNode;
    } else {
        rear->next = newNode;
        rear = newNode;
    }
    count++;
    cout << "Movie Enqueued Successfully!" << endl;
    return true;
}

Movie CAQueue::Dequeue() {
    if (Isempty()) {
        cout << "Queue is Empty!" << endl;
        return Movie();
    }

    Node* temp = front;
    Movie m = front->data;
    front = front->next;
    if (front == NULL) {
        rear = NULL;
    }
    delete temp;
    count--;
    cout << "Movie Dequeued Successfully!" << endl;
    return m;
}

Movie CAQueue::Peek() {
    if (Isempty()) {
        cout << "Queue is Empty!" << endl;
        return Movie();
    }

    cout << "\n|----- THE FRONT MOVIE -----|\n";
    cout << "Title\tNAME\tAge\tPrice\n";
    front->data.DisplayMovie();

    cout << "\n|------- THE REAR MOVIE ------|\n";
    cout << "Title\tNAME\tAge\tPrice\n";
    rear->data.DisplayMovie();

    return front->data;
}

void CAQueue::Makequeueempty() {
    while (!Isempty()) {
        Dequeue();
    }
    cout << "Queue Emptied!" << endl;
}

