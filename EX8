// ===== Queue =====
Queue::Queue(int c)
{
    capacity = c;
    front = rear = -1;
    arr = new int[c];
}
Queue::~Queue() { delete[] arr; }
bool Queue::isEmpty() { return front == -1 || front > rear; }
bool Queue::isFull() { return rear == capacity - 1; }
void Queue::enqueue(int x)
{
    if (isFull()) return;
    if (front == -1) front = 0;
    arr[++rear] = x;
}
int Queue::dequeue()
{
    if (isEmpty()) return -1;
    int x = arr[front++];
    if (front > rear) front = rear = -1;
    return x;
}

// ===== GraphAdjMatrix =====
GraphAdjMatrix::GraphAdjMatrix(int n1)
{
    n = n1;
    movies = new Movie[n];
    matrix = new int *[n];
    for (int i = 0; i < n; i++)
    {
        matrix[i] = new int[n];
        for (int j = 0; j < n; j++) matrix[i][j] = 0;
    }
}
GraphAdjMatrix::~GraphAdjMatrix()
{
    for (int i = 0; i < n; i++) delete[] matrix[i];
    delete[] matrix;
    delete[] movies;
}
void GraphAdjMatrix::getMovies()
{
    for (int i = 0; i < n; i++)
    {
        cout << "\nMovie " << i << ":\n";
        movies[i].getMovie();
    }
}
void GraphAdjMatrix::getConnections()
{
    int s, d;
    char ch;
    do
    {
        cout << "Enter connection (source destination): ";
        cin >> s >> d;
        if (s >= 0 && d >= 0 && s < n && d < n && s != d)
        {
            matrix[s][d] = matrix[d][s] = 1;
        }
        else
            cout << "Invalid!\n";
        cout << "Add more (y/n)? ";
        cin >> ch;
    } while (ch == 'y' || ch == 'Y');
}


void GraphAdjMatrix::BFS(int start)
{
    bool *visited = new bool[n]();
    Queue q(n);

    cout << "\nBFS Traversal (Movies):\nName\tTitle\tPrice\tAge\t";
    for (int i = 0; i < n; ++i)
    
        int currentNode = (i == 0) ? start : i;
        
        if (!visited[currentNode])
        {
            q.enqueue(currentNode);
            visited[currentNode] = true;

            while (!q.isEmpty())
            {
                int v = q.dequeue();
                movies[v].displayMovie(); 
                
                
                for (int j = 0; j < n; j++)
                {
                    if (matrix[v][j] == 1 && !visited[j])
                    {
                        q.enqueue(j);
                        visited[j] = true;
                    }
                }
            }
        }
    }
    delete[] visited;
}


void GraphAdjMatrix::DFS(int start)
{
    bool *visited = new bool[n]();
    cout << "\nDFS Traversal (Movies):\nName\tTitle\tPrice\tAge\n";
    
 
    DFSRecursive(start, visited);

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            DFSRecursive(i, visited);
        }
    }

    delete[] visited;
}


void GraphAdjMatrix::DFSRecursive(int v, bool *visited)
{
    visited[v] = true;
    movies[v].displayMovie();
    for (int i = 0; i < n; i++)
        if (matrix[v][i] == 1 && !visited[i])
            DFSRecursive(i, visited);
}

